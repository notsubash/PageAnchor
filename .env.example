DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PAGEANCHOR_CORPUS_ROOT=./corpus
LANCEDB_URI=./corpus/lancedb
GENERATOR_MODEL=deepseek-v4-flash
TEXT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VISUAL_RETRIEVE_MODEL=vidore/colqwen2-v1.0
STRICT_VERIFY=true
PAGEANCHOR_LAYOUT=pymupdf
# PAGEANCHOR_DEVICE=cuda
# Empty: cuda if torch.cuda.is_available() else cpu. Set cpu to force CPU.
# CUDA torch (Windows/Linux NVIDIA). PyPI torch is CPU; CUDA wheels lag
# (2.11.0+cu128 as of 2026-09, not 2.13):
# uv pip install torch torchvision --index-url https://download.pytorch.org/whl/cu128
# Then: uv run --no-sync ...  (plain uv sync puts CPU torch back)
# Web overlay (apps/web): NEXT_PUBLIC_API_URL=http://localhost:8000
# RETRIEVAL_MIN_SCORE is not wired; AbstainReason.low_retrieval_score is unused.
# Unanswerable and answerable hit scores overlap. Abstain on no_hits /
# verify_failed / generator_invalid / unanswerable only. See docs/EVAL.md.
